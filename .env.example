# =============================================================================
# PulseVault Full-Stack Environment Variables (.env.example)
# Copy the Backend variables to `backend/.env` (or Render Environment Variables)
# and the Frontend variables to `frontend/.env` (or Vercel Environment Variables).
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Render / backend/.env)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String (Required in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auctionpulse?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_SOCKET_TIMEOUT_MS=45000
SEED_DEMO_DATA=true

# Frontend & CORS Origins (Vercel Production URL)
CLIENT_URL=https://auctionspace-psi.vercel.app
CLIENT_APP_URL=https://auctionspace-psi.vercel.app
FRONTEND_URL=https://auctionspace-psi.vercel.app
CORS_ORIGIN=https://auctionspace-psi.vercel.app
CORS_ORIGINS=https://auctionspace-psi.vercel.app
PUBLIC_API_URL=https://<your-render-backend>.onrender.com

# Authentication & Static Admin Account
JWT_SECRET=<your-strong-random-jwt-secret>
JWT_EXPIRE=30d
ADMIN_EMAIL=admin@bidpulse.io
ADMIN_PASS=<your-admin-password>

# Built-In Free Mode Flags (Set to false if using external Stripe / Cloudinary / SMTP)
FREE_ESCROW_MODE=true
LOCAL_MEDIA_STORAGE=false
LOCAL_EMAIL_INBOX=false

# Bot Protection (Use free-local-shield-secret for built-in PulseShield, or your Cloudflare Turnstile secret)
TURNSTILE_SECRET_KEY=free-local-shield-secret

# Optional: Stripe Payments (Required only if FREE_ESCROW_MODE=false)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Cloudinary Media Storage (Recommended in production for persistent uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=AuctionPulse

# Optional: Transactional Email (Brevo / Resend / SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AuctionPulse Support
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_SERVICE=gmail
EMAIL_USERNAME=
EMAIL_PASSWORD=
SUPPORT_EMAIL=
PROMOTIONAL_EMAIL_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Vercel / frontend/.env)
# -----------------------------------------------------------------------------
VITE_API_URL=https://<your-render-backend>.onrender.com/api
VITE_SOCKET_URL=https://<your-render-backend>.onrender.com
VITE_BACKEND_URL=https://<your-render-backend>.onrender.com
VITE_TURNSTILE_SITE_KEY=free-local-shield-sitekey
